  "segments": [
    { "id": 1, "speaker": "旁白", "text": "蜗牛和玫瑰树。" },
    { "id": 2, "speaker": "旁白", "text": "花园中央有一棵玫瑰树，树下住着一只蜗牛。" },
    { "id": 3, "speaker": "旁白", "text": "玫瑰树每天都能看见阳光、雨水和来来往往的小动物。蜗牛每天都能看见玫瑰树的根、花园里的石头和泥土上的小路。" },
    { "id": 4, "speaker": "旁白", "text": "它们住得很近，却有完全不同的生活。" },
    { "id": 5, "speaker": "旁白", "text": "春天，玫瑰树开出了第一朵花。" },
    { "id": 6, "speaker": "旁白", "text": "蜜蜂飞过来，停在花心里；蝴蝶飞过来，在花瓣旁边休息；路过的小朋友也会停下来闻一闻。" },
    { "id": 7, "speaker": "旁白", "text": "蜗牛从树下慢慢爬出来，抬头看着玫瑰花。" },
    { "id": 8, "speaker": "蜗牛", "text": "你真漂亮。不过你等着吧。我以后也会做出一件很了不起的事情。" },
    { "id": 9, "speaker": "旁白", "text": "玫瑰树轻轻摇了摇花枝。" },
    { "id": 10, "speaker": "玫瑰树", "text": "好呀，我等着看。你想做什么呢？" },
    { "id": 11, "speaker": "旁白", "text": "蜗牛把触角伸得高高的。" },
    { "id": 12, "speaker": "蜗牛", "text": "我还没有想好。不过，一定要很特别，最好是大家都没有做过的事情。" },
    { "id": 13, "speaker": "旁白", "text": "从那以后，蜗牛每天都在想。" },
    { "id": 14, "speaker": "旁白", "text": "它想过要爬上最高的石头，想过要走到花园的另一边，还想过要把自己的小房子装饰成一座漂亮的宫殿。" },
    { "id": 15, "speaker": "旁白", "text": "可是，它每天都只走了一小段路。" },
    { "id": 16, "speaker": "旁白", "text": "夏天来了，玫瑰树开了更多花。花香飘到了篱笆外面，许多小动物都来花园做客。" },
    { "id": 17, "speaker": "旁白", "text": "小蜜蜂问玫瑰树。" },
    { "id": 18, "speaker": "小蜜蜂", "text": "你每天开这么多花，累不累呀？" },
    { "id": 19, "speaker": "玫瑰树", "text": "我喜欢把香味送给大家。每开一朵花，我就觉得很开心。" },
    { "id": 20, "speaker": "旁白", "text": "小蜗牛也想帮忙，可它没有花蜜，也没有翅膀。" },
    { "id": 21, "speaker": "旁白", "text": "于是它沿着花园的小路慢慢爬。它发现，清晨下过雨以后，小路上有许多小水坑；太阳出来以后，水坑会变得很热；只有大树旁边的那一段路，一整天都凉凉的。" },
    { "id": 22, "speaker": "旁白", "text": "蜗牛把这件事告诉小动物们。" },
    { "id": 23, "speaker": "蜗牛", "text": "天气热的时候，大家可以从大树旁边走。那里有阴凉的叶子。" },
    { "id": 24, "speaker": "旁白", "text": "小蚂蚁照着它说的路线找到了食物，小甲虫也在大树下躲过了大雨。" },
    { "id": 25, "speaker": "旁白", "text": "玫瑰树看见了。" },
    { "id": 26, "speaker": "玫瑰树", "text": "你观察得真仔细。" },
    { "id": 27, "speaker": "旁白", "text": "蜗牛却摇摇头。" },
    { "id": 28, "speaker": "蜗牛", "text": "这还不算了不起。我还没有做出真正特别的事情。" },
    { "id": 29, "speaker": "旁白", "text": "秋天到了，玫瑰花慢慢变成了红色的小果子。花园里的叶子开始飘落，金色的叶子落满了小路。" },
    { "id": 30, "speaker": "旁白", "text": "蜗牛看着玫瑰树。" },
    { "id": 31, "speaker": "蜗牛", "text": "你开了花，结了果子，一直在给别人带来好东西。你是不是已经做完了自己想做的事情？" },
    { "id": 32, "speaker": "旁白", "text": "玫瑰树想了一会儿。" },
    { "id": 33, "speaker": "玫瑰树", "text": "我不知道什么叫做‘做完’。我只是到了春天就开花，到了秋天就结出果子。只要阳光和雨水还在，我就继续长大。" },
    { "id": 34, "speaker": "蜗牛", "text": "可是你从来不想着做一件惊天动地的事情吗？" },
    { "id": 35, "speaker": "旁白", "text": "玫瑰树笑了。" },
    { "id": 36, "speaker": "玫瑰树", "text": "我没有那么大的力气去想那么远。我只能把今天的花开好，把今天的香味送出去。" },
    { "id": 37, "speaker": "旁白", "text": "蜗牛低下头，看了看小路。" },
    { "id": 38, "speaker": "蜗牛", "text": "那我呢？我走得这么慢，又不会开花。" },
    { "id": 39, "speaker": "玫瑰树", "text": "你可以看看你身边。也许你已经做了很多事情，只是自己没有发现。" },
    { "id": 40, "speaker": "旁白", "text": "这一年冬天来得很早。夜里的风把树叶吹得到处都是，花园的小路被叶子盖住了。小蚂蚁找不到回家的路，小甲虫也找不到原来躲雨的石头。" },
    { "id": 41, "speaker": "旁白", "text": "蜗牛决定帮它们整理小路。" },
    { "id": 42, "speaker": "旁白", "text": "它用头把一片叶子推到路边，再慢慢推另一片。叶子比它大很多，每推一步，它都要停下来休息。" },
    { "id": 43, "speaker": "旁白", "text": "小蚂蚁看见了，赶来帮它拉叶子。" },
    { "id": 44, "speaker": "旁白", "text": "小甲虫也来了，用自己的小脚把叶子往旁边推。" },
    { "id": 45, "speaker": "旁白", "text": "蜗牛负责指路，大家一起把小路清理出来。" },
    { "id": 46, "speaker": "蜗牛", "text": "从这里走，就能到树根下面。" },
    { "id": 47, "speaker": "蜗牛", "text": "绕过这片叶子，前面有一块干燥的石头。" },
    { "id": 48, "speaker": "旁白", "text": "很快，小路重新出现了。冬天的雨水流下来时，叶子堆在土边，像一条柔软的小毯子，盖住了土里的种子。" },
    { "id": 49, "speaker": "旁白", "text": "玫瑰树安静地看着这一切。" },
    { "id": 50, "speaker": "玫瑰树", "text": "谢谢你。" },
    { "id": 51, "speaker": "旁白", "text": "蜗牛有些不好意思。" },
    { "id": 52, "speaker": "蜗牛", "text": "我只是慢慢推了几片叶子。" },
    { "id": 53, "speaker": "玫瑰树", "text": "可如果没有你，大家不知道该从哪里走。" },
    { "id": 54, "speaker": "旁白", "text": "冬天过去，春天重新来到花园。" },
    { "id": 55, "speaker": "旁白", "text": "土里的小种子一个接一个地发芽。它们有的长成小花，有的长成嫩草，还有一棵小玫瑰长在玫瑰树旁边。" },
    { "id": 56, "speaker": "小玫瑰", "text": "是谁给我盖了被子？" },
    { "id": 57, "speaker": "玫瑰树", "text": "是蜗牛和花园里的朋友们。" },
    { "id": 58, "speaker": "旁白", "text": "蜗牛听了，连忙把身体缩进壳里。" },
    { "id": 59, "speaker": "蜗牛", "text": "我没有做什么了不起的事情。" },
    { "id": 60, "speaker": "旁白", "text": "玫瑰树把一朵刚开的花伸到它的壳边。" },
    { "id": 61, "speaker": "玫瑰树", "text": "了不起不一定要让所有人都看见。你走得慢，所以看见了落在路上的叶子；你没有翅膀，所以知道小动物们从哪里回家；你不喜欢大声说话，却一直在认真做事。" },
    { "id": 62, "speaker": "旁白", "text": "蜗牛从壳里伸出触角。" },
    { "id": 63, "speaker": "蜗牛", "text": "原来，我也有自己的本领。" },
    { "id": 64, "speaker": "玫瑰树", "text": "当然有。每一朵花有自己的香味，每一只蜗牛也有自己的脚步。" },
    { "id": 65, "speaker": "旁白", "text": "从那以后，玫瑰树负责开花，蜗牛负责照看小路。花园里一个送来花香，一个送来安静；一个在枝头等待阳光，一个在泥土边发现细小的事情。" },
    { "id": 66, "speaker": "旁白", "text": "它们都不再催促对方变成自己。" },
    { "id": 67, "speaker": "旁白", "text": "春风吹过，玫瑰花瓣落在蜗牛的壳上。蜗牛慢慢爬过小路，身后留下一道亮晶晶的痕迹。" },
    { "id": 68, "speaker": "玫瑰树", "text": "你的路走得真漂亮。" },
    { "id": 69, "speaker": "蜗牛", "text": "你的花也开得正好。" },
    { "id": 70, "speaker": "旁白", "text": "花园里的小动物听见了，都开心地笑起来。" },
    { "id": 71, "speaker": "旁白", "text": "原来，走得快有走得快的好处，走得慢也有走得慢的礼物。只要认真做自己能做的事情，就能给身边的世界带来一点美好。" }
  ]
